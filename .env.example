# Copy to .env and fill in. Never commit .env.

# --- Solana / Helius ---
# Helius RPC HTTP endpoint (includes your api-key in the URL).
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Helius WebSocket endpoint for log subscriptions.
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Telegram ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Target chat id (user, group, or channel). Group ids are negative.
TELEGRAM_CHAT_ID=

# --- Behaviour ---
# true = never actually send Telegram messages (logs only). Default true for safety.
DRY_RUN=true
# Max launches a creator may have (inclusive) to be eligible.
MAX_CREATOR_LAUNCHES=10
# How long (minutes) to keep polling DEX Screener per token after launch.
WATCH_WINDOW_MINUTES=1440
# SQLite file path.
DATABASE_PATH=./data/tracker.db

# --- DEX Screener polling budget (requests/min, keep under documented limits) ---
# Orders endpoint documented at 60 req/min.
ORDERS_RPM=50
# Token/pairs endpoint documented at 300 req/min.
TOKENS_RPM=240

# --- Startup backfill (optional, OFF by default) ---
# Max transactions to scan for launches from the last 24h on start. 0 = off.
# The DBC program is very busy (~1000 tx / 30s) so even 5000 only reaches back a
# few minutes and costs that many RPC calls per restart.
BACKFILL_MAX_TX=0

# --- Logging ---
LOG_LEVEL=info
