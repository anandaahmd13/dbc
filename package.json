{
  "name": "dbc-dex-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram tracker for new Meteora Dynamic Bonding Curve launches: DEX Screener paid profile + social updates, filtered to creators with <=10 launches.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "tsx src/scripts/inspect-mint.ts",
    "test-latest": "tsx src/scripts/test-latest.ts",
    "diagnose": "tsx src/scripts/diagnose.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
